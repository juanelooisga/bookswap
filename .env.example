# Copiar a .env y ajustar valores (XAMPP / MySQL)
APP_NAME=BookSwap
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/bookswap/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bookswap
DB_USER=root
DB_PASS=

# Prefijo de rutas API (sin barra final)
API_PREFIX=/api

# Demo alojada: usar una base dedicada y TLS verificado
DB_SSL=false
DB_SSL_CA=/etc/secrets/mysql-ca.pem
DEMO_MODE=false
DEMO_INITIALIZE=false
